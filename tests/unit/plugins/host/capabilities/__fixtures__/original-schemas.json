            },
            "conceptName": {
              "type": "string",
              "description": "Human-readable concept name"
            },
            "domain": {
              "type": "string",
              "enum": [
                "Condition",
                "Drug",
                "Procedure",
                "Measurement",
                "Observation",
                "Visit",
                "Device",
                "Specimen"
              ],
              "description": "OMOP domain"
            },
            "group": {
              "type": "string",
              "enum": [
                "inclusion",
                "exclusion"
              ]
            },
            "includeDescendants": {
              "type": "boolean"
            },
            "operator": {
              "type": "string",
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte",
                "eq",
                "between"
              ],
              "description": "Measurement value operator (only for Measurement domain)"
