{$CADDY_HOSTNAME:localhost} {
	{$CADDY_TLS_DIRECTIVE:tls internal}

	redir / /atlas/ permanent
	redir /atlas /atlas/ permanent

	handle /WebAPI/* {
		reverse_proxy {$WEBAPI_HOST:atlas3-webapi}:{$WEBAPI_PORT:8080}
	}

	handle /atlas/* {
		root * /srv
		try_files {path} /atlas/index.html
		file_server
	}
}
