{$CADDY_HOSTNAME:localhost} {
	{$CADDY_TLS_DIRECTIVE:tls internal}

	# Baseline hardening headers. frame-ancestors / X-Frame-Options block
	# cross-origin framing (clickjacking) of the authenticated UI.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
		-Server
	}

	redir / /atlas/ permanent
	redir /atlas /atlas/ permanent

	handle /WebAPI/* {
		reverse_proxy {$WEBAPI_HOST:atlas3-webapi}:{$WEBAPI_PORT:8080}
	}

	handle_path /atlas/* {
		root * {$ATLAS_DIST:/srv/atlas}
		try_files {path} /index.html
		file_server
	}
}
