{
  "api": { "url": "/WebAPI" },
  "userAuthenticationEnabled": true,
  "authProviders": [
    {
      "name": "Database",
      "url": "user/login/db",
      "ajax": true,
      "icon": "mdi-database",
      "isUseCredentialsForm": true
    }
  ],
  "analytics": {
    "provider": "${ANALYTICS_PROVIDER}",
    "endpoint": "${OTLP_ENDPOINT}",
    "sampleRatio": ${OTEL_SAMPLE_RATIO},
    "traceApiCalls": true,
    "traceDocumentLoad": true,
    "identifyUsers": true,
    "scrubUrlQueryStrings": true
  }
}
