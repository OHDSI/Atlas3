# Copy this file to .env and fill in the values to enable the Pythia
# AI agent locally. Neither var is required when pythia is disabled.

# Surfaces the Pythia FAB + chat panel in the Atlas3 frontend. Build-time
# only: changing this requires `docker compose up -d --build atlas3-frontend`.
VITE_BAO_AGENT_ENABLED=true

# Bedrock long-term API key consumed by the bao plugin (baked into the
# WebAPI image) for `Authorization: Bearer …` calls to bedrock-runtime.
#
# Mint one with:
#   aws iam create-service-specific-credential \
#     --user-name <iam-user> --service-name bedrock.amazonaws.com
#
# Treat as a secret — `.env` is gitignored, `.env.example` is not.
AWS_BEARER_TOKEN_BEDROCK=

# Optional override for which Bedrock model bao uses. Defaults to
# minimax.minimax-m2.5 (cheap, strong tool-routing). For higher quality
# at higher cost try us.anthropic.claude-haiku-4-5-20251001-v1:0 or
# us.anthropic.claude-sonnet-4-5-20251001-v1:0.
#BAO_AGENT_MODEL=minimax.minimax-m2.5
