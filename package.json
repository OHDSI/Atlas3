{
  "name": "atlas-cohort-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OHDSI Atlas Cohort Builder",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=12288 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=12288 vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:visual": "playwright test tests/e2e/visual-comparison.spec.ts",
    "check-all": "npm run type-check && npm run lint && npm run test:unit && npm run build",
    "prepare": "husky",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts && git diff --exit-code src/ui/tokens.css",
    "predev": "npm run tokens:build",
    "generate:routes": "node scripts/emit-route-manifest.mjs",
    "prebuild": "npm run tokens:build && npm run generate:routes",
    "ui:dev": "histoire dev",
    "ui:build": "histoire build"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^14.0.0",
    "d3": "^7.9.0",
    "date-fns": "^3.0.0",
    "echarts": "^6.0.0",
    "jose": "^6.1.1",
    "papaparse": "^5.5.3",
    "pinia": "^2.1.0",
    "sass": "^1.93.3",
    "single-spa": "^6.0.3",
    "single-spa-vue": "^3.0.1",
    "systemjs": "^6.15.1",
    "uuid": "^13.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^0.17.17",
    "@playwright/test": "^1.40.0",
    "@types/d3": "^7.4.3",
    "@types/echarts": "^4.9.22",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.5.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^9.19.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "fake-indexeddb": "^6.2.5",
    "histoire": "^0.17.17",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "prettier": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue-tsc": "^3.1.3"
  }
}
